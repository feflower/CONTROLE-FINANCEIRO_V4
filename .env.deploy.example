# Copie este arquivo para .env NO SERVIDOR e preencha.
# O .env NAO vai para o controle de versao (esta no .gitignore).

# Auth key do Tailscale.
#   Admin do Tailscale -> Settings -> Keys -> Generate auth key
#   Marque "Reusable" para poder subir o container mais de uma vez.
#   Formato: tskey-auth-XXXXXXXXXX-XXXXXXXXXXXXXXXXXXXX
TS_AUTHKEY=
